        <mxCell id="state" value="&lt;b&gt;Your saved state&lt;/b&gt; (localStorage)&lt;br&gt;major · courses taken · cart&lt;br&gt;theme (white/red) · view (graph/grid) · group by" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF9F7;strokeColor=#A8A29E;fontSize=12;" vertex="1" parent="web">
