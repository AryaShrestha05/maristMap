<mxfile host="app.diagrams.net" agent="maristMap" version="24.0.0">
  <diagram id="maristmap-architecture" name="How maristMap works">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="maristMap — how it works" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#C8102E;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Built once from Marist's public catalog → runs entirely in the student's browser" style="text;html=1;fontSize=14;fontColor=#78716C;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="900" height="26" as="geometry" />
        </mxCell>

        <!-- ===================== Stage 1: sources ===================== -->
        <mxCell id="src" value="1 · Marist sources (public)" style="swimlane;html=1;startSize=34;fontSize=14;fontStyle=1;fillColor=#FBEAED;strokeColor=#C8102E;fontColor=#1C1917;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="300" height="330" as="geometry" />
        </mxCell>
        <mxCell id="catalog" value="&lt;b&gt;2026–27 Undergraduate Catalog&lt;/b&gt;&lt;br&gt;catalog.marist.edu&lt;br&gt;&lt;font color=&quot;#78716C&quot;&gt;1,557 course pages · 126 program pages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7E5E4;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="src">
          <mxGeometry x="20" y="50" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="corepdf" value="&lt;b&gt;Core/LS Breadth lists&lt;/b&gt;&lt;br&gt;marist.edu/academics/core/breadth&lt;br&gt;&lt;font color=&quot;#78716C&quot;&gt;8 official PDFs (Literature, History…)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7E5E4;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="src">
          <mxGeometry x="20" y="150" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="corepage" value="&lt;b&gt;Core/Liberal Studies page&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#78716C&quot;&gt;category structure, 46 credits,&lt;br&gt;“cross-listed counts once” rule&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7E5E4;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="src">
          <mxGeometry x="20" y="250" width="260" height="66" as="geometry" />
        </mxCell>

        <!-- ===================== Stage 2: build ===================== -->
        <mxCell id="build" value="2 · Data build (run once, by us)" style="swimlane;html=1;startSize=34;fontSize=14;fontStyle=1;fillColor=#F5F5F4;strokeColor=#A8A29E;fontColor=#1C1917;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="390" y="110" width="420" height="330" as="geometry" />
        </mxCell>
        <mxCell id="collect" value="&lt;b&gt;Collect in a real browser&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#78716C&quot;&gt;site blocks scripts → fetched page by page,&lt;br&gt;resumable → data/raw/*.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7E5E4;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="build">
          <mxGeometry x="20" y="50" width="380" height="64" as="geometry" />
        </mxCell>
        <mxCell id="parsers" value="&lt;b&gt;scripts/build-data.ts&lt;/b&gt;&lt;br&gt;parseCourse → code, title, credits, offered, description&lt;br&gt;parsePrereq → “A and (B or C)” logic, &lt;i&gt;never guesses&lt;/i&gt;&lt;br&gt;parsePrograms → majors, concentrations, requirement groups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7E5E4;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="build">
          <mxGeometry x="20" y="130" width="380" height="84" as="geometry" />
        </mxCell>
        <mxCell id="datafiles" value="&lt;b&gt;src/data/courses.json&lt;/b&gt;  1,557 courses&lt;br&gt;&lt;b&gt;src/data/majors.json&lt;/b&gt;  82 majors &amp;amp; concentrations&lt;br&gt;&lt;b&gt;src/data/core.ts&lt;/b&gt;  Core categories + rules, each linked to its PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1C1917;strokeColor=#1C1917;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="build">
          <mxGeometry x="20" y="232" width="380" height="80" as="geometry" />
        </mxCell>

        <!-- ===================== Stage 3: the website ===================== -->
        <mxCell id="web" value="3 · The website (runs in the student's browser, no server)" style="swimlane;html=1;startSize=34;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#C8102E;strokeWidth=2;fontColor=#C8102E;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="1640" height="560" as="geometry" />
